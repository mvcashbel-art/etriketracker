{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false
    },
    "trikes": {
      ".read": true,
      "$id": {
        ".write": true,
        ".validate": "newData.hasChildren(['lat','lng','ts'])"
      }
    },
    "shifts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["startAt"],
      "$id": {
        ".write": "!data.exists() || data.child('status').val() === 'open'",
        ".validate": "newData.hasChildren(['body','name','startAt','status'])"
      }
    },
    "trips": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["startAt"],
      "$id": {
        ".write": "!data.exists() || data.child('status').val() === 'active'",
        ".validate": "newData.hasChildren(['body','pName','pPhone','startAt','status'])"
      }
    },
    "tracks": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$body": {
        "$day": {
          "$ts": {
            ".write": "!data.exists()"
          }
        }
      }
    },
    "audit": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
